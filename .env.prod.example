# Adana Özel Ders — ÜRETİM ortam değişkenleri.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod'u ASLA git'e eklemeyin (.gitignore'da). Değerlerin bir kopyasını
# şifre yöneticisinde (Bitwarden/1Password) tutun — sunucu kaybında tek
# kopyanız o olur. Ayrı bir Vault kurmak bu ölçekte gereksizdir.
#
# Uygulama açılışta bu dosyayı DOĞRULAR (core/config.py::_guard_production):
# aşağıdakilerden biri bile eksik/yanlışsa backend AÇILMAZ ve tüm eksikleri
# tek hatada listeler. Sessizce yanlış çalışmaktansa açılmamak doğrudur.

# ── Zorunlu: ortam ──
ENVIRONMENT=production

# ── Alan adı / TLS ──
DOMAIN=adanaozelders.com.tr
ACME_EMAIL=you@example.com

FRONTEND_BASE_URL=https://adanaozelders.com.tr
BACKEND_BASE_URL=https://adanaozelders.com.tr
PUBLIC_TRACKING_BASE_URL=https://adanaozelders.com.tr/kargo-takip
BACKEND_CORS_ORIGINS=["https://adanaozelders.com.tr"]

# Caddy compose ağından bağlanır; Docker'ın varsayılan aralığı.
# Bu liste BOŞ bırakılırsa istemci IP'si çözülemez ve IP bazlı rate-limit'ler
# tek kovada toplanır (bkz. core/ratelimit.py).
TRUSTED_PROXY_IPS=["172.16.0.0/12"]

# ── Veritabanı ──
POSTGRES_USER=adana
POSTGRES_PASSWORD=BURAYA-GUCLU-PAROLA
POSTGRES_DB=adana

# ── Sırlar ──
# Üret: openssl rand -hex 32
JWT_SECRET_KEY=BURAYA-EN-AZ-32-KARAKTER-RASTGELE
# Ayrı ve KALICI olmalı: değişirse şifreli TCKN alanları bir daha çözülemez.
FIELD_ENCRYPTION_KEY=BURAYA-AYRI-RASTGELE-DEGER

# ── Nesne deposu (MinIO) ──
AWS_ACCESS_KEY_ID=BURAYA-ANAHTAR
AWS_SECRET_ACCESS_KEY=BURAYA-GIZLI
AWS_BUCKET_NAME=avatars
# Tarayıcının depoya eriştiği adres = Caddy'deki `depo.<DOMAIN>` bloğu.
# `depo` için DNS'te A kaydı açılmalı (aynı IP). Dosya adresleri ve imzalı
# (presigned) adresler bununla üretilir; imza host'u kapsadığından bu değer
# tarayıcının gerçekten kullandığı adresle BİREBİR aynı olmalıdır.
S3_PUBLIC_ENDPOINT_URL=https://depo.adanaozelders.com.tr

# ── Ödeme (iyzico) ──
# fake bırakılırsa guard açılışı engeller: sahte sağlayıcı para tahsil etmeden
# "başarılı" döner ve tüm satışlar bedava olur.
PAYMENT_PROVIDER=iyzico
IYZICO_API_KEY=BURAYA
IYZICO_SECRET_KEY=BURAYA
IYZICO_BASE_URL=https://api.iyzipay.com
PLATFORM_COMMISSION_RATE=0.10

# ── E-posta ──
# console bırakılırsa mailler yalnız loga yazılır (guard engeller).
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@adanaozelders.com.tr
EMAIL_FROM_NAME=Adana Özel Ders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=BURAYA
SMTP_PASSWORD=BURAYA-UYGULAMA-SIFRESI
SMTP_USE_TLS=True

# ── SMS ──
# console bırakılırsa teslimat/telefon OTP'leri müşteriye GİTMEZ, loga yazılır
# (guard engeller).
SMS_PROVIDER=netgsm
NETGSM_USERCODE=BURAYA
NETGSM_PASSWORD=BURAYA
NETGSM_MSGHEADER=BURAYA

# ── Yönetici hesabı (ilk seed) ──
ADMIN_EMAIL=admin@adanaozelders.com.tr
ADMIN_PASSWORD=BURAYA-GUCLU-PAROLA
ADMIN_FULL_NAME=Sistem Yöneticisi

# ── Gözlemlenebilirlik ──
# Sentry ücretsiz katmanı (5k olay/ay) yeter. Boş bırakılırsa canlıdaki
# hatalardan haberiniz olmaz.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO

# ── Harita / adres ──
GOOGLE_MAPS_API_KEY=

# ── Teslimat operasyonu ──
DELIVERY_DEPOT_LAT=36.985500
DELIVERY_DEPOT_LNG=35.325300
DELIVERY_CUTOFF_HOUR=16
DELIVERY_ZONE_RADIUS_KM=25
DELIVERY_DAILY_CAPACITY=30
