# Adana Özel Ders — ÜRETİM ortam değişkenleri.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod'u ASLA git'e eklemeyin (.gitignore'da). Değerlerin bir kopyasını
# şifre yöneticisinde (Bitwarden/1Password) tutun — sunucu kaybında tek
# kopyanız o olur. Ayrı bir Vault kurmak bu ölçekte gereksizdir.
#
# Uygulama açılışta bu dosyayı DOĞRULAR (core/config.py::_guard_production):
# aşağıdakilerden biri bile eksik/yanlışsa backend AÇILMAZ ve tüm eksikleri
# tek hatada listeler. Sessizce yanlış çalışmaktansa açılmamak doğrudur.

# ── Zorunlu: ortam ──
ENVIRONMENT=production

# ── Alan adı / TLS ──
DOMAIN=adanaozelders.com.tr
ACME_EMAIL=you@example.com

FRONTEND_BASE_URL=https://adanaozelders.com.tr
BACKEND_BASE_URL=https://adanaozelders.com.tr
PUBLIC_TRACKING_BASE_URL=https://adanaozelders.com.tr/kargo-takip
BACKEND_CORS_ORIGINS=["https://adanaozelders.com.tr"]

# Caddy compose ağından bağlanır; Docker'ın varsayılan aralığı.
# Bu liste BOŞ bırakılırsa istemci IP'si çözülemez ve IP bazlı rate-limit'ler
# tek kovada toplanır (bkz. core/ratelimit.py).
TRUSTED_PROXY_IPS=["172.16.0.0/12"]

# ── Veritabanı ──
POSTGRES_USER=adana
POSTGRES_PASSWORD=BURAYA-GUCLU-PAROLA
POSTGRES_DB=adana

# ── Sırlar ──
# Üret: openssl rand -hex 32
JWT_SECRET_KEY=BURAYA-EN-AZ-32-KARAKTER-RASTGELE
# Ayrı ve KALICI olmalı: değişirse şifreli TCKN alanları bir daha çözülemez.
FIELD_ENCRYPTION_KEY=BURAYA-AYRI-RASTGELE-DEGER

# ── Nesne deposu (Cloudflare R2) ──
# R2 API token'ı (Object Read & Write, YALNIZ iki bucket'a kapsamlı). Sır:
# repoya, loga ya da sohbete yazılmaz.
AWS_ACCESS_KEY_ID=BURAYA-R2-ACCESS-KEY-ID
AWS_SECRET_ACCESS_KEY=BURAYA-R2-SECRET
AWS_REGION_NAME=auto
# R2 S3 API adresi (hesap kimliğiyle). Private dosyaların imzalı adresleri
# YALNIZ bununla üretilir; CDN adresiyle asla.
AWS_ENDPOINT_URL=https://BURAYA-HESAP-KIMLIGI.r2.cloudflarestorage.com
# İki AYRI bucket (guard aynı adı reddeder). Public bucket'a cdn custom domain
# bağlanır; private bucket'a custom domain ya da r2.dev AÇILMAZ.
S3_PUBLIC_BUCKET=adanaozelders-public
S3_PRIVATE_BUCKET=adanaozelders-private
S3_PUBLIC_BASE_URL=https://cdn.adanaozelders.com.tr
# Eski MinIO adresleri (DB'de kalmış tam URL'ler) açıkça tanınsın diye.
# Biçim `{eski depo adresi}/{eski bucket adı}`: eski URL'ler path-style idi
# (`https://depo.adanaozelders.com.tr/avatars/<anahtar>`) ve `/avatars` host
# kökü değil BUCKET adıdır; kök verilirse anahtar `avatars/...` diye yanlış
# çıkar. Salt-okunur sayım sıfır eski kayıt gösterirse boş bırakılabilir.
S3_LEGACY_BASE_URLS=https://depo.adanaozelders.com.tr/avatars
# scripts/backup-postgres.sh: eski MinIO aynalaması (varsayılan kapalı). Yalnız
# `true` iken çalışır; başarısızlığı DB yedeğini ve restic'i durdurmaz.
BACKUP_MINIO_ENABLED=false

# ── Ödeme (iyzico) ──
# fake bırakılırsa guard açılışı engeller: sahte sağlayıcı para tahsil etmeden
# "başarılı" döner ve tüm satışlar bedava olur.
PAYMENT_PROVIDER=iyzico
IYZICO_API_KEY=BURAYA
IYZICO_SECRET_KEY=BURAYA
IYZICO_BASE_URL=https://api.iyzipay.com
PLATFORM_COMMISSION_RATE=0.10

# ── E-posta ──
# console bırakılırsa mailler yalnız loga yazılır (guard engeller).
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@adanaozelders.com.tr
EMAIL_FROM_NAME=Adana Özel Ders
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=BURAYA
SMTP_PASSWORD=BURAYA-UYGULAMA-SIFRESI
SMTP_USE_TLS=True

# ── SMS ──
# console bırakılırsa teslimat/telefon OTP'leri müşteriye GİTMEZ, loga yazılır
# (guard engeller).
SMS_PROVIDER=netgsm
NETGSM_USERCODE=BURAYA
NETGSM_PASSWORD=BURAYA
NETGSM_MSGHEADER=BURAYA

# ── Yönetici hesabı (ilk seed) ──
ADMIN_EMAIL=admin@adanaozelders.com.tr
ADMIN_PASSWORD=BURAYA-GUCLU-PAROLA
ADMIN_FULL_NAME=Sistem Yöneticisi

# ── Gözlemlenebilirlik ──
# Sentry ücretsiz katmanı (5k olay/ay) yeter. Boş bırakılırsa canlıdaki
# hatalardan haberiniz olmaz.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=INFO

# ── Harita / adres ──
GOOGLE_MAPS_API_KEY=

# ── Teslimat operasyonu ──
DELIVERY_DEPOT_LAT=36.985500
DELIVERY_DEPOT_LNG=35.325300
DELIVERY_CUTOFF_HOUR=16
DELIVERY_ZONE_RADIUS_KM=25
DELIVERY_DAILY_CAPACITY=30

# ── Google ile giriş (OAuth 2.0 / OpenID Connect) ──
# Boş bırakılırsa özellik TAMAMEN KAPALIDIR: /auth/google/* uçları 404 döner ve
# arayüz düğmeyi hiç çizmez. Geliştirmede dış hesap gerekmesin diye varsayılan
# bu. İKİSİNDEN YALNIZ BİRİ doldurulursa özellik yine kapalı kalır ve üretimde
# açılış guard'ı bunu bir yapılandırma hatası olarak bildirir.
#
# Google Cloud Console'da yapılacaklar:
#   1. OAuth consent screen -> External. Kapsam (scope) YALNIZ openid +
#      userinfo.email + userinfo.profile; bunlar hassas değildir, yani Google'ın
#      uygulama doğrulama süreci GEREKMEZ. Gizlilik ve kullanım koşulları
#      adresleri sitede zaten var (/gizlilik-politikasi, /kullanim-kosullari).
#      Ekranı PUBLISH edin: "Testing" modunda yalnız eklediğiniz test
#      kullanıcıları girebilir ve oturumlar 7 günde ölür.
#   2. Credentials -> OAuth client ID -> "Web application". iOS/Android/Desktop
#      seçilirse client_secret verilmez ve bu akış çalışmaz.
#   3. Authorized redirect URIs (BİREBİR eşleşir, tek karakter fark
#      "redirect_uri_mismatch" verir):
#        http://localhost:8000/api/v1/auth/google/callback
#        https://<alan-adiniz>/api/v1/auth/google/callback
#      Authorized JavaScript origins BOŞ kalır (tarayıcı akışı kullanılmıyor).
#
# UYARI: LAN IP'siyle (http://192.168.x.x:5173) test edilemez; Google özel IP'li
# redirect URI kabul etmez. Telefon testi alan adı ya da tünel ile yapılır.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Gerçek-zamanlı (Centrifugo) ──
# İKİSİ DE `openssl rand -hex 32` ile üretilir ve JWT_SECRET_KEY'den FARKLI
# olmalıdır. Aynı olurlarsa uygulama AÇILMAZ (core/config.py::_guard_centrifugo):
# ortak sır, Centrifugo bağlantı token'ının API access token'ı olarak da kabul
# edilmesi demektir. Boş bırakılırlarsa da açılmaz — compose'da
# CENTRIFUGO_ENABLED=True'dur ve yarım yapılandırma sessizce kapalı kalmamalıdır.
#   CENTRIFUGO_TOKEN_HMAC_SECRET → istemciye verilen bağlantı JWT'sini imzalar
#   CENTRIFUGO_API_KEY           → sunucu→Centrifugo HTTP API çağrılarını yetkilendirir
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_API_KEY=

# ── Canlı ders (LiveKit, self-hosted) ──
# Üçü de BOŞKEN özellik kapalıdır: `/bookings/{id}/live-token` 503 döner
# (açılış guard'ı bunu ENGELLEMEZ — eksik yapılandırma yalnız bu ucu etkiler).
# `livekit` servisi ise ayağa kalkmaz: compose bu üç değeri ZORUNLU tutar.
#   LIVEKIT_API_KEY / LIVEKIT_API_SECRET → `openssl rand -hex 32` ile üretin;
#     hem backend token'ı imzalamak hem LiveKit doğrulamak için aynı çifti
#     kullanır (compose'da LIVEKIT_KEYS olarak birleştirilir).
#   LIVEKIT_NODE_IP → sunucunun DIŞ IPv4'ü. Yanlışsa sinyalleşme çalışır ama
#     ses/görüntü hiç akmaz (medya adayları erişilemez adresi gösterir).
#   LIVEKIT_URL → tarayıcının bağlandığı adres = Caddy'deki `canli.<DOMAIN>`
#     bloğu. `canli` için DNS'te A kaydı açılmalı (aynı IP).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=
LIVEKIT_URL=wss://canli.adanaozelders.com.tr

# ── Canlı ders sağlayıcısı (Zoom Video SDK) ──
# "Derse katıl" hangi altyapıya gider: zoom | livekit | jitsi (varsayılan zoom).
# Zoom anahtarları BOŞKEN uygulama yine açılır; `/bookings/{id}/zoom-token`
# 503 döner ve açılışta "Canlı ders KAPALI" uyarısı loglanır.
#   ZOOM_VIDEO_SDK_KEY / ZOOM_VIDEO_SDK_SECRET → marketplace.zoom.us →
#     Develop → Video SDK uygulaması → SDK Key / SDK Secret.
CANLI_DERS_SAGLAYICI=zoom
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

#  Amazon SP-API 
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_REGION=eu
AMAZON_SP_API_MARKETPLACE_ID=A33AVAJ2PDY3EV
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

