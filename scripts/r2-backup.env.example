# scripts/r2-backup.sh sır dosyası örneği. GERÇEK DEĞER YAZILMAZ.
# Sunucuda: install -m 600 /dev/null /root/r2-yedek.env && nano /root/r2-yedek.env
#
# İki AYRI Cloudflare R2 token'ı:
#   okuma → Object Read,         kapsam: adanaozelders-public + adanaozelders-private
#   yazma → Object Read & Write, kapsam: YALNIZ adanaozelders-backups
# Production uygulama token'ı (.env.prod) burada kullanılmaz.

R2_YEDEK_ENDPOINT=https://BURAYA-HESAP-KIMLIGI.r2.cloudflarestorage.com
R2_YEDEK_OKUMA_ACCESS_KEY_ID=BURAYA
R2_YEDEK_OKUMA_SECRET_ACCESS_KEY=BURAYA
R2_YEDEK_YAZMA_ACCESS_KEY_ID=BURAYA
R2_YEDEK_YAZMA_SECRET_ACCESS_KEY=BURAYA

# İsteğe bağlı (varsayılanlar):
# R2_YEDEK_PUBLIC_BUCKET=adanaozelders-public
# R2_YEDEK_PRIVATE_BUCKET=adanaozelders-private
# R2_YEDEK_BACKUP_BUCKET=adanaozelders-backups
# R2_YEDEK_MAX_SILME=20         # tek koşuda bundan fazla silme/taşıma → koşu durur (veri büyüdükçe yükseltin)
# R2_YEDEK_SNAPSHOT_GUNU=7      # UTC haftanın günü (date +%u), 7 = Pazar
