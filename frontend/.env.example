# Göreli base + Vite proxy (vite.config.ts): aynı origin → CORS preflight YOK,
# hem localhost hem ağ (telefon) üzerinde IP yazmadan çalışır. WebSocket dahil.
VITE_API_BASE_URL=/api/v1

# Alternatif (proxy'siz, backend'e doğrudan): mutlak URL ver. Ağ paylaşımında
# localhost yerine makinenin LAN IP'sini yazman gerekir, ör:
# VITE_API_BASE_URL=http://10.62.0.178:8000/api/v1

# Kanonik URL / OG etiketleri (lib/seo.ts). Boşsa runtime origin kullanılır.
# Üretimde imaj build'inde verilir (docker-compose.prod.yml).
VITE_SITE_URL=

# ── Hata izleme (opsiyonel) ──
# Boş bırakılırsa tamamen no-op: geliştirmede dış hesap GEREKMEZ.
# Üretimde doldurun; aksi halde kullanıcının ödeme ekranında gördüğü beyaz
# ekranı ancak o kişi size ulaşırsa öğrenirsiniz. Sentry ücretsiz katmanı
# (5k olay/ay) bu ölçekte yeter.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ── Ziyaretçi analitiği (opsiyonel, ÇEREZSİZ) ──
# Boş bırakılırsa script hiç yüklenmez (no-op). Çerezsiz sağlayıcı seçilmesi
# bilinçlidir: çerezli analitik açık rıza gerektirir ve siteye çerez onay bandı
# eklemek zorunda kalırdık.
# Adres KENDİ alan adımızdan olmalı (Caddy /istatistik/* → analitik sunucusu):
# üçüncü taraf host, CSP'deki `script-src 'self'` kuralını delerdi.
#   Üretim: /istatistik/script.js
#   Yerel:  http://localhost:3001/script.js  (docker compose --profile analytics)
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_WEBSITE_ID=

# ── Harita döşemeleri (opsiyonel) ──
# Boş bırakılırsa OpenStreetMap kullanılır. OSMF politikası TİCARİ kullanımı
# yasaklar: engellendiği gün kütüphane haritası, checkout adres pin'i ve canlı
# kurye takibi AYNI ANDA çöker. Geçiş için burayı doldurmak yeterlidir
# (Protomaps self-host / MapTiler / başka bir sağlayıcı).
#   VITE_MAP_TILE_URL=https://tiles.ornek.com/{z}/{x}/{y}.png
#   VITE_MAP_TILE_ATTRIBUTION=&copy; Örnek Sağlayıcı
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
