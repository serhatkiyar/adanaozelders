# Göreli base + Vite proxy (vite.config.ts): aynı origin → CORS preflight YOK,
# hem localhost hem ağ (telefon) üzerinde IP yazmadan çalışır. WebSocket dahil.
VITE_API_BASE_URL=/api/v1

# Alternatif (proxy'siz, backend'e doğrudan): mutlak URL ver. Ağ paylaşımında
# localhost yerine makinenin LAN IP'sini yazman gerekir, ör:
# VITE_API_BASE_URL=http://10.62.0.178:8000/api/v1

# Kanonik URL / OG etiketleri (lib/seo.ts). Boşsa runtime origin kullanılır.
# Üretimde imaj build'inde verilir (docker-compose.prod.yml).
VITE_SITE_URL=

# ── Hata izleme (opsiyonel) ──
# Boş bırakılırsa tamamen no-op: geliştirmede dış hesap GEREKMEZ.
# Üretimde doldurun; aksi halde kullanıcının ödeme ekranında gördüğü beyaz
# ekranı ancak o kişi size ulaşırsa öğrenirsiniz. Sentry ücretsiz katmanı
# (5k olay/ay) bu ölçekte yeter.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
