# Adana Özel Ders — üretim reverse proxy'si (TLS sonlandırma).
#
# Caddy sertifikayı Let's Encrypt'ten otomatik alır ve yeniler; ayrı bir certbot
# kurulumu/cron'u gerekmez. Kubernetes/nginx-ingress bu ölçekte gereksizdir.
#
# Kullanım (docker-compose.prod.yml içinden):
#   DOMAIN=adanaozelders.com.tr ACME_EMAIL=... docker compose -f docker-compose.prod.yml up -d
#
# DNS: A kaydı sunucunun IP'sine bakmalı; 80 ve 443 dışarıya açık olmalı
# (80 olmadan ACME HTTP-01 doğrulaması yapılamaz).

{
	email {$ACME_EMAIL}
	# Sertifika denemelerini test ederken staging'i açın; oran sınırına takılmayın:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# ── Güvenlik başlıkları ──
	header {
		# HSTS: bir kez HTTPS gören tarayıcı bir daha düz HTTP denemez.
		# preload listesine başvurmadan önce alt alan adlarınızın tamamının
		# HTTPS olduğundan emin olun.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kamera ve mikrofon kendi kaynağımıza: canlı ders iki yönlüdür,
		# `microphone=()` onu tarayıcı seviyesinde tamamen kapatıyordu.
		# Caddy'nin `header` direktifi değeri EKLEMEZ, DEĞİŞTİRİR: bu satır
		# frontend nginx'inin kendi Permissions-Policy'sini ezer, yani ikisi
		# BİRLİKTE değişmelidir (frontend/nginx-security-headers.conf).
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self)"
		# Sunucu parmak izini azalt.
		-Server
		# BURAYA Content-Security-Policy EKLEMEYİN. CSP tek kaynakta,
		# frontend/nginx-security-headers.conf içinde tanımlıdır. Tarayıcı birden
		# çok CSP başlığı gördüğünde hepsinin KESİŞİMİNİ uygular; iki liste
		# zamanla ayrıştığında yüzeyler açıklaması zor biçimlerde kırılır.
	}

	# ── API ──
	# Backend istemci IP'sini X-Forwarded-For'dan okur; bunu YALNIZCA
	# TRUSTED_PROXY_IPS içindeki bir bağlantıdan gelirse kabul eder.
	# Compose ağında Caddy'nin IP'si sabit olmadığından üretim .env'inde
	# TRUSTED_PROXY_IPS=["172.16.0.0/12"] (Docker varsayılan aralığı) verin.
	# Hero create iki ayrı 12 MB görsel alabilir; multipart payı için 26 MB.
	@store_hero_create {
		path /api/v1/admin/store-hero-slides
		method POST
	}
	handle @store_hero_create {
		request_body {
			max_size 26MB
		}
		reverse_proxy backend:8000
	}

	# Tek görsel değiştirme ucu: 12 MB dosya + multipart payı.
	@store_hero_replace {
		path_regexp storeHeroReplace ^/api/v1/admin/store-hero-slides/[0-9]+/image$
		method POST
	}
	handle @store_hero_replace {
		request_body {
			max_size 13MB
		}
		reverse_proxy backend:8000
	}

	# Yeni vitrin medya kütüphanesi tek 12 MB dosya kabul eder.
	@store_merchandising_media {
		path /api/v1/admin/store-merchandising/media
		method POST
	}
	handle @store_merchandising_media {
		request_body {
			max_size 13MB
		}
		reverse_proxy backend:8000
	}

	# Eski ana-akış ve özel kart düzenleyicileri en fazla dört görsel taşır;
	# multipart alan payıyla gövdeyi proxy katmanında 50 MB'ta kes.
	@store_multi_image_uploads {
		path /api/v1/admin/store-home-sections/images /api/v1/admin/store-home-sections/*/images /api/v1/admin/store-showcase-cards/custom /api/v1/admin/store-showcase-cards/*/custom
		method POST PUT
	}
	handle @store_multi_image_uploads {
		request_body {
			max_size 50MB
		}
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# iyzico ödeme callback'i: kullanıcının TARAYICISI buraya POST eder.
	handle /payments/* {
		reverse_proxy backend:8000
	}

	# WebSocket (mesaj/bildirim push'ları) — Caddy upgrade'i kendiliğinden taşır.
	handle /ws* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	# ── Ziyaretçi analitiği (first-party proxy) ──
	# Script ve olay gönderimi KENDİ alan adımızdan geçer. İki sebep:
	#   1. CSP'de `script-src 'self'` bozulmasın — üçüncü taraf bir host'a izin
	#      vermek XSS savunmasında açacağımız ilk delik olurdu.
	#   2. Reklam engelleyiciler bilinen analitik alan adlarını engeller; kendi
	#      yolumuz engellenmediğinden ölçüm yanlılığı azalır.
	# `ANALYTICS_UPSTREAM` verilmezse bu blok yalnızca 502 döner (analitik
	# kapalıdır; frontend zaten script'i hiç yüklemez).
	handle_path /istatistik/* {
		reverse_proxy {$ANALYTICS_UPSTREAM:umami:3000}
	}

	# Sitemap dinamik üretilir (onaylı eğitmenler + ACTIVE kütüphane/ürün).
	# Arama motorları alan adının KÖKÜNDE arar; /api/v1 altında kalırsa
	# alışılmış konumda bulunmaz.
	handle /sitemap.xml {
		reverse_proxy backend:8000
	}

	# ── Sosyal paylaşım önizlemesi ──
	# WhatsApp/Twitter/Facebook/LinkedIn/Telegram önizleme botları JS
	# ÇALIŞTIRMAZ: SPA'nın runtime meta etiketleri onlara görünmez ve her
	# paylaşım jenerik site başlığıyla çıkar. Bu botlara sunucuda üretilmiş
	# meta HTML'i veriyoruz.
	#
	# GOOGLEBOT BİLEREK LİSTEDE YOK: Google JS render eder ve gerçek sayfayı
	# görmelidir. Ona farklı içerik sunmak "cloaking" sayılır ve cezalandırılır.
	# Regex TIRNAK İÇİNDE olmalı: "quora link preview" boşluk taşıdığı için
	# tırnaksız yazıldığında Caddy onu üç ayrı argüman sayar ve config adapter
	# "wrong argument count ... after 'preview|vkshare)'" ile açılışta ölür.
	@social_bot header_regexp User-Agent "(?i)(facebookexternalhit|twitterbot|whatsapp|linkedinbot|slackbot|telegrambot|discordbot|pinterest|redditbot|skypeuripreview|embedly|quora link preview|vkshare)"
	handle @social_bot {
		rewrite * /__meta?path={uri}
		reverse_proxy backend:8000
	}

	# ── SPA ──
	# Kök SEO sayfaları (ders / ilçe+ders / ilan, Modül 6) da buradan
	# frontend'e gider; ön-çizim için backend'e yönlendirme frontend
	# nginx'indedir (frontend/nginx.conf) — CSP başlığı tek kaynakta kalsın ve
	# backend düşerse nginx normal index.html'e geri düşebilsin diye. Ayrım
	# YOLA göredir, user-agent'a değil: Googlebot ve kullanıcı aynı HTML'i alır.
	handle {
		reverse_proxy frontend:80
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# ── Dosya deposu ────────────────────────────────────────────────────────────────
#
# 27 Eyl 2026: dosyalar Cloudflare R2'de; `depo.<alan>` MinIO proxy'si kaldırıldı.
# Public görseller `cdn.<alan>` (R2 custom domain, Cloudflare'de) üzerinden,
# private dosyalar yalnız R2 S3 API'sinin imzalı adresiyle açılır — ikisi de bu
# sunucudan geçmez. Güvenlik başlıkları (nosniff, X-Frame-Options, CSP sandbox)
# Cloudflare'de cdn için Transform Rule ile verilir.

# ── Canlı ders signaling (LiveKit) ──────────────────────────────────────────
#
# Tarayıcı buraya WebSocket ile bağlanır (LIVEKIT_URL=wss://canli.<alan>);
# TLS burada sonlanır, LiveKit'in kendisi iç ağda düz HTTP konuşur ve 7880'i
# host'a hiç yayınlamaz. `reverse_proxy` WebSocket upgrade'ini kendiliğinden
# taşır (yukarıdaki /ws bloğuyla aynı).
#
# Medya (7881/tcp, 7882/udp) BURADAN GEÇMEZ: UDP'yi Caddy taşıyamaz, o portlar
# docker-compose.prod.yml'de doğrudan yayınlanır ve sunucu güvenlik duvarında
# açık olmalıdır.
#
# Gerekenler: `canli` için A kaydı (aynı IP).
# CSP EKLENMEZ: CSP tek kaynakta (frontend/nginx-security-headers.conf).
canli.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy livekit:7880

	log {
		output file /var/log/caddy/livekit.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
