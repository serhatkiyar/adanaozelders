# ── Çalışma ortamı ───────────────────────────────────────────────────────────
# development | staging | production
# "production" seçilirse açılışta SERTLEŞTİRME GUARD'ı koşar (core/config.py::
# _guard_production): aşağıdaki geliştirme kolaylıkları üretime sızarsa uygulama
# AÇILMAZ ve eksiklerin tamamını tek hatada listeler —
#   PAYMENT_PROVIDER=fake      → para tahsil etmeden sipariş kapatır
#   EMAIL_PROVIDER/SMS=console → e-posta ve OTP müşteriye değil loga gider
#   AUTO_CREATE_DB=True        → migration'ı açılışta çalıştırır
#   SEED_DEMO_DATA=True        → şifresi kodda açık demo eğitmenleri canlıya koyar
#   zayıf JWT_SECRET_KEY, minioadmin anahtarları, localhost CORS, http:// URL'ler
ENVIRONMENT=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ceyhandb

DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token ömrü (gün). Access süresi dolunca /auth/refresh ile rotasyonla yenilenir.
REFRESH_TOKEN_EXPIRE_DAYS=30
LAST_SEEN_THROTTLE_SECONDS=60

# Açılışta `alembic upgrade head` + seed. ÜRETİMDE False olmalı; migration'ı
# deploy adımı olarak çalıştırın: docker compose run --rm backend alembic upgrade head
AUTO_CREATE_DB=True
# Demo/başlangıç eğitmenleri (core/seed.py::seed_tutors). Şifreleri KODDA AÇIK
# yazılıdır ve kayıtlar APPROVED gelir → yalnız geliştirme/demo ortamında True.
SEED_DEMO_DATA=True
ADMIN_EMAIL=admin@ceyhan.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FULL_NAME=System Admin

# Redis (presence + rate limiting). Docker compose'da: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Ters proxy / istemci IP'si ───────────────────────────────────────────────
# X-Forwarded-For YALNIZCA bu listedeki bir adresten gelen bağlantılarda okunur.
# Boş = header'a hiç güvenme (doğrudan bağlantı IP'si kullanılır).
# Aksi halde saldırgan her istekte sahte XFF göndererek TÜM IP bazlı
# rate-limit'leri (login brute-force, kayıt spam'i, e-posta maliyeti) delebilir.
# Tek adres, CIDR veya "*" kabul edilir. Örn. Caddy/nginx önde: ["127.0.0.1"]
# Docker ağında proxy başka konteynerse: ["172.16.0.0/12"]
TRUSTED_PROXY_IPS=[]

# Rate limiting (fixed-window, Redis yoksa fail-open). Pencere tüm limitler için ortak.
RATE_LIMIT_WINDOW_SECONDS=60
# IP bazlı (auth uçları):
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_EMAIL=5
# Kullanıcı bazlı (yazma uçları):
RATE_LIMIT_BOOKING=10
RATE_LIMIT_MESSAGE=30
RATE_LIMIT_QA=15
RATE_LIMIT_DEMAND=10
RATE_LIMIT_REVIEW=10
RATE_LIMIT_PAYMENT=10
RATE_LIMIT_REPORT=5
RATE_LIMIT_GEOCODE=90

# Adres arama / geocode. Geliştirmede DIŞ HESAP/ANAHTAR GEREKMEZ:
#   (boş)                    -> Nominatim/OpenStreetMap'e fallback (ücretsiz, anahtarsız)
#   GOOGLE_MAPS_API_KEY=...   -> Google Places API (New) + Geocoding (anahtar YALNIZ
#                    sunucuda; autocomplete session token + field mask ile düşük maliyet)
# Üretimde yalnız bu değer doldurulur. Google Cloud Console'da etkinleştirilmesi gereken
# API'ler: "Places API (New)" ve "Geocoding API".
GOOGLE_MAPS_API_KEY=

# ── Google ile giriş (OAuth 2.0 / OpenID Connect) ──
# Boş bırakılırsa özellik TAMAMEN KAPALIDIR: /auth/google/* uçları 404 döner ve
# arayüz düğmeyi hiç çizmez. Geliştirmede dış hesap gerekmesin diye varsayılan
# bu. İKİSİNDEN YALNIZ BİRİ doldurulursa özellik yine kapalı kalır ve üretimde
# açılış guard'ı bunu bir yapılandırma hatası olarak bildirir.
#
# Google Cloud Console'da yapılacaklar:
#   1. OAuth consent screen -> External. Kapsam (scope) YALNIZ openid +
#      userinfo.email + userinfo.profile; bunlar hassas değildir, yani Google'ın
#      uygulama doğrulama süreci GEREKMEZ. Gizlilik ve kullanım koşulları
#      adresleri sitede zaten var (/gizlilik-politikasi, /kullanim-kosullari).
#      Ekranı PUBLISH edin: "Testing" modunda yalnız eklediğiniz test
#      kullanıcıları girebilir ve oturumlar 7 günde ölür.
#   2. Credentials -> OAuth client ID -> "Web application". iOS/Android/Desktop
#      seçilirse client_secret verilmez ve bu akış çalışmaz.
#   3. Authorized redirect URIs (BİREBİR eşleşir, tek karakter fark
#      "redirect_uri_mismatch" verir):
#        http://localhost:8000/api/v1/auth/google/callback
#        https://<alan-adiniz>/api/v1/auth/google/callback
#      Authorized JavaScript origins BOŞ kalır (tarayıcı akışı kullanılmıyor).
#
# UYARI: LAN IP'siyle (http://192.168.x.x:5173) test edilemez; Google özel IP'li
# redirect URI kabul etmez. Telefon testi alan adı ya da tünel ile yapılır.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Ters-geocode (harita sürükleme/geolocation → adres) Places API'de YOK, Geocoding
# API gerektirir. Varsayılan True: key olsa bile reverse'i ücretsiz Nominatim'e ver →
# yalnız "Places API (New)" açık yeter, en sık çağrı ücretsiz kalır. False yaparsan
# reverse de Google'a gider (o zaman konsolda "Geocoding API" de etkin olmalı).
GEOCODE_REVERSE_USE_NOMINATIM=True
GEOCODE_COUNTRY=tr
GEOCODE_LANGUAGE=tr
# Sonuçları yerele yaklaştırmak için arama yanlılığı (Adana merkezli — depo çevresi).
GEOCODE_BIAS_LAT=36.985500
GEOCODE_BIAS_LNG=35.325300
GEOCODE_BIAS_RADIUS_M=30000

# E-posta gönderimi. Geliştirmede DIŞ HESAP/ANAHTAR GEREKMEZ:
#   EMAIL_PROVIDER=console -> e-postayı göndermez, içeriğini (linki) loglar
#   EMAIL_PROVIDER=smtp    -> MailHog'a yazar (docker compose; web UI http://localhost:8025)
# Üretimde aynı arayüzle gerçek SMTP relay'e geçilir (yalnız bu değerler değişir).
#
# GOOGLE WORKSPACE (Gmail SMTP) ile üretim gönderimi — kod değişmez, yalnız bu blok:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=gonderen@alanadiniz.com       # gönderim yapan Workspace hesabı
#   SMTP_PASSWORD=<16-haneli-uygulama-sifresi>  # myaccount.google.com/apppasswords (2FA gerekli), boşluksuz
#   SMTP_USE_TLS=True                           # 587 = STARTTLS
#   EMAIL_FROM=gonderen@alanadiniz.com          # From = giriş hesabı VEYA ona tanımlı "Send As" alias'ı
# Not: no-reply@ göstermek için o adresi Workspace'te hesaba alias olarak ekle; yoksa Gmail From'u
# sessizce giriş hesabına çevirir. Günlük ~2000 mail; daha fazlası için smtp-relay.gmail.com (admin console).
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@adanaozelders.com.tr
EMAIL_FROM_NAME=Adana Özel Ders
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
# WhatsApp doğrulama kodu (önce WhatsApp, olmazsa SMS). off | waha | meta
# waha: docker-compose.waha.yml ile kendi sunucumuzda; WAHA_URL iç ağ adresi.
WHATSAPP_PROVIDER=off
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WHATSAPP_OTP_SAATLIK_SINIR=3
# E-posta linklerinin işaret edeceği frontend kökü (doğrulama/şifre sıfırlama).
FRONTEND_BASE_URL=http://localhost:5173
# SEO ön-çizimi için derlenmiş index.html şablonunun iç adresi (üretimde http://frontend:80).
# Yerelde Vite de verilebilir: FRONTEND_INTERNAL_URL=http://localhost:5173
FRONTEND_INTERNAL_URL=
# Oturumsuz kargo takip linkinin (SMS'le paylaşılır) kökü. URL = {base}/{token}.
# Geliştirmede frontend + /kargo-takip; üretimde kargotakip.* subdomain'i.
PUBLIC_TRACKING_BASE_URL=http://localhost:5173/kargo-takip
# Token ömürleri (saat).
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Ödeme (escrow). Geliştirmede DIŞ HESAP/ANAHTAR GEREKMEZ:
#   PAYMENT_PROVIDER=fake   -> anında başarı (tüm escrow akışı localhost'ta denenebilir)
#   PAYMENT_PROVIDER=iyzico -> üretim; IYZICO_* anahtarları + sandbox/prod URL gerekir
# PLATFORM_COMMISSION_RATE: 0..1 arası (0.10 = %10 komisyon).
PAYMENT_PROVIDER=fake
PAYMENT_CURRENCY=TRY
PLATFORM_COMMISSION_RATE=0.10
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Teslimat rota optimizasyonu (Faz B). Geliştirmede KURULUM GEREKMEZ:
#   ROUTING_PROVIDER=auto      -> VROOM dene, erişilemezse haversine fallback (kurulumsuz)
#   ROUTING_PROVIDER=vroom     -> zorunlu VROOM (compose --profile routing + scripts/setup-osrm-adana.{sh,ps1})
#   ROUTING_PROVIDER=haversine -> her zaman kurulumsuz yaklaşık rota
# ÜRETİMDE `haversine` GUARD TARAFINDAN REDDEDİLİR: kuş uçuşu tahmin müşteriye
# yanlış varış penceresi ("18:00–19:00") sözü verir. `auto` serbesttir — VROOM
# düşerse sistem çalışmaya devam eder ve bozulma /health ile ERROR log'da görünür.
# VROOM_URL: host'ta uvicorn -> localhost:3000; konteynerde -> http://vroom:3000
# (konteynerde `localhost` VROOM değil backend'in KENDİSİDİR — guard bunu da reddeder).
ROUTING_PROVIDER=auto
VROOM_URL=http://localhost:3000
# İstek tavanı; DB_POOL_TIMEOUT_SECONDS'tan uzun beklemek havuzu yer.
VROOM_TIMEOUT_SECONDS=20
# Tek planlamadaki azami koordinat (durak + depo). `osrm-routed --max-table-size`
# BUNDAN BÜYÜK olmalı (compose: 500) — yoksa 100+ duraklı kampanya gününde OSRM
# "TooBig" döner ve rota sessizce tahmine geriler.
VROOM_MAX_LOCATIONS=300
# Devre kesici: VROOM düştükten sonra bu kadar saniye yeniden denenmez
# ("Günü Optimize Et" tek istekte 1+N planlama çağırır). 0 = kapalı.
ROUTING_FAILURE_COOLDOWN_SECONDS=60

# Dosya depolama (S3/MinIO). Docker compose'da AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION_NAME=us-east-1
AWS_BUCKET_NAME=avatars
AWS_ENDPOINT_URL=http://localhost:9000
# Tarayıcının depoya eriştiği adres. Yalnız dahili adres farklıysa gerekir
# (compose: backend `minio:9000` kullanır, tarayıcı `localhost:9000`). İmzalı
# adreslerin imzası host'u kapsadığı için bu ayrım önemlidir. Boşsa
# AWS_ENDPOINT_URL kullanılır.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Hassas dosyalar (private/ öneki) anonim okunamaz; imzalı adresin ömrü:
# S3_PRESIGN_TTL_SECONDS=3600
# Ders materyali (dosya eki) yükleme boyut limiti (bayt). Varsayılan 10 MB.
MAX_RESOURCE_SIZE_BYTES=10485760

# Geçmiş onaylı dersleri otomatik tamamlama (saat).
AUTO_COMPLETE_GRACE_HOURS=12

# ── Canlı ders ───────────────────────────────────────────────────────────────
# "Derse katıl" hangi altyapıya gider: zoom | livekit | jitsi (varsayılan zoom).
# Anahtarlar BOŞKEN uygulama yine açılır; yalnız ilgili token ucu 503 döner
# ve açılışta bir uyarı loglanır. Değerleri buraya YAZMAYIN, yerel .env'e koyun.
CANLI_DERS_SAGLAYICI=zoom
# Zoom Video SDK (marketplace.zoom.us → Develop → Video SDK uygulaması →
# SDK Key / SDK Secret). Secret yalnız sunucuda durur; JWT'yi imzalar.
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
# LiveKit (self-hosted SFU; `/bookings/{id}/live-token`). Üçü de boşsa kapalı.
#   LIVEKIT_URL → tarayıcının bağlanacağı wss:// adres
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gözlemlenebilirlik. Request-id her zaman çalışır; Sentry yalnız SENTRY_DSN
# verilirse etkin (yoksa no-op — geliştirmede dış hesap gerekmez).
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Tedarikçi senkronu (Yıldırım B2B) ────────────────────────────────────────
# API TOKEN'I BURADA DEĞİLDİR. Panelden girilir (/yonetim/magaza/tedarikci) ve
# veritabanında ŞİFRELİ durur (`suppliers.api_token`). Env'e koymak rotasyonu
# deploy'a bağlar ve sırrı üç ortama kopyalar.
# Senkron SIKLIĞI da env'de değil: tedarikçi kaydında yaşar, panelden
# değiştirilir ve yeniden başlatma gerektirmez.
#
# Aşağıdakiler yalnız süreç düzeyi teknik ayarlardır; varsayılanlar üretim
# için uygundur ve normalde DEĞİŞTİRİLMEZ.
# SUPPLIER_SYNC_TICK_SECONDS=15        # döngü ne sıklıkla vadeye bakar
# SUPPLIER_HTTP_TIMEOUT_SECONDS=15
# SUPPLIER_REQUEST_GAP_SECONDS=0.8     # rapor §2.11: origin zayıf, ölçülmüş kural
# SUPPLIER_STALE_FACTOR=3              # /health "bayat" eşiği (aralığın katı)
# SUPPLIER_MAX_COOLDOWN_SECONDS=1800   # devre kesici tavanı
# SUPPLIER_TOKEN_REFRESH_DAYS=7        # vadeye bu kadar gün kala yenile
#
# TESTLERDE True (bkz. backend/conftest.py): istemci gerçek ağa çıkmayı
# reddeder. Üretimde False olmalı, yoksa senkron hiç koşmaz.
# SUPPLIER_NETWORK_DISABLED=False
