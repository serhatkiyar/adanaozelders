# Amazon SP-API Credentials
# DO NOT ADD THE REAL .env FILE TO GIT!
# Rename this file to .env and fill in your actual credentials.

LWA_APP_ID=amzn1.sp.solution...
LWA_CLIENT_ID=amzn1.application-oa2-client...
LWA_CLIENT_SECRET=...
SP_API_REFRESH_TOKEN=...

# SP-API Endpoint (Choose your region endpoint)
# North America (US, CA, MX): https://sellingpartnerapi-na.amazon.com
# Europe/Turkey (UK, DE, TR vb): https://sellingpartnerapi-eu.amazon.com
# Far East (JP, SG vb): https://sellingpartnerapi-fe.amazon.com
SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
